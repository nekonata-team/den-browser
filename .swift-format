{
  "indentation" : {
    "spaces" : 4
  },
  "lineLength" : 120,
  "rules" : {
    "NeverForceUnwrap" : true,
    "DoNotUseSemicolons" : true,
    "NeverUseForceTry" : true,
    "NeverUseImplicitlyUnwrappedOptionals" : false,
    "OrderedImports" : true,
    "UseEarlyExits" : true
  },
  "version" : 1
}
