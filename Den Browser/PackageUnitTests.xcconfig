// Keep compiler warnings fatal for Den's Swift package targets.
SWIFT_TREAT_WARNINGS_AS_ERRORS = $(DEN_STRICT_WARNINGS_$(TARGET_NAME))
DEN_STRICT_WARNINGS_DenDomain = YES
DEN_STRICT_WARNINGS_DenDomainTests = YES
DEN_STRICT_WARNINGS_DenApplication = YES
DEN_STRICT_WARNINGS_DenApplicationTests = YES
DEN_STRICT_WARNINGS_DenModels = YES
DEN_STRICT_WARNINGS_DenModelsTests = YES
DEN_STRICT_WARNINGS_DenInfrastructure = YES
DEN_STRICT_WARNINGS_DenInfrastructureTests = YES
DEN_STRICT_WARNINGS_DenIPCProtocol = YES
DEN_STRICT_WARNINGS_DenIPCProtocolTests = YES
DEN_STRICT_WARNINGS_DenViews = YES
DEN_STRICT_WARNINGS_DenViewsTests = YES
