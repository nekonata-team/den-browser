---
import type { home } from '../i18n/ui';

type AgentSection = (typeof home)['en']['agentUseCases'];

interface Props {
	copy: AgentSection;
}

const { copy } = Astro.props;
const inlineCodeClass = 'bg-white/5 px-1.5 py-0.5 rounded border border-white/10 text-cyan-300 font-mono text-xs';
---

<section id="agents" class="py-20 border-t border-white/5 bg-gradient-to-b from-black/20 to-black/40 px-6">
	<div class="mx-auto max-w-7xl">
		<div class="text-center mb-16">
			<span class="text-xs font-bold uppercase tracking-wider text-cyan-400">{copy.eyebrow}</span>
			<h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 mb-4 tracking-tight">{copy.title}</h2>
			<p class="text-zinc-400 max-w-2xl mx-auto leading-relaxed">{copy.description}</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
			{copy.cases.map((useCase) => (
				<div class="glass-card rounded-2xl p-6 border border-white/10 flex flex-col justify-between gap-5 overflow-hidden">
					<div class="flex flex-col gap-2.5">
						<div class="inline-flex items-center self-start">
							<span class="text-[10px] font-bold uppercase tracking-widest text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-2 py-0.5 rounded-full">
								{useCase.badge}
							</span>
						</div>
						<h3 class="text-lg sm:text-xl font-bold text-white tracking-tight leading-snug">{useCase.title}</h3>
						<p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
							{useCase.description.map((part) =>
								typeof part === 'string' ? part : <code class={inlineCodeClass}>{part.code}</code>
							)}
						</p>
					</div>

					<div class="glass-panel rounded-xl overflow-hidden shadow-2xl border border-white/10 aspect-video relative mt-2 group">
						<div class="absolute top-0 left-0 right-0 z-10 bg-black/50 border-b border-white/5 px-3 py-2 flex items-center justify-between backdrop-blur-sm pointer-events-none">
							<div class="flex items-center gap-1.5">
								<span class="w-2 h-2 rounded-full bg-red-500/40"></span>
								<span class="w-2 h-2 rounded-full bg-yellow-500/40"></span>
								<span class="w-2 h-2 rounded-full bg-green-500/40"></span>
							</div>
							<div class="text-[9px] font-medium text-zinc-400 bg-white/5 px-2 py-0.5 rounded border border-white/5 font-mono">
								{useCase.badge}
							</div>
							<div class="w-6"></div>
						</div>

						<video
							class="bento-video w-full h-full object-cover pt-7"
							src={useCase.video}
							muted
							loop
							playsinline
							preload="none"
						>
							Your browser does not support the video tag.
						</video>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	const videos = document.querySelectorAll<HTMLVideoElement>('.bento-video');
	if ('IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const video = entry.target as HTMLVideoElement;
					if (entry.isIntersecting) {
						video.play().catch(() => {});
					} else {
						video.pause();
					}
				});
			},
			{ rootMargin: '100px 0px', threshold: 0.1 }
		);
		videos.forEach((video) => observer.observe(video));
	} else {
		videos.forEach((video) => video.play().catch(() => {}));
	}
</script>
