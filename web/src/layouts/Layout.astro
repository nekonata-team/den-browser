---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homePath = lang === 'en' ? '/' : '/ja/';
const alternatePath = lang === 'en' ? `/ja${Astro.url.pathname}` : Astro.url.pathname.replace(/^\/ja/, '') || '/';
const pageDescription = description ?? (lang === 'ja'
	? 'macOSのための、キーボードファーストな空間ブラウザ。Web、AIチャット、調査、開発、ターミナル作業を並列化。'
	: 'Den Browser - A keyboard-first spatial browser for macOS. Parallel web work, the Niri way.');
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth bg-[#090c12] text-zinc-200">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/app-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Den Browser</title>
		<meta name="description" content={pageDescription} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={pageDescription} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={pageDescription} />
	</head>
	<body class="min-h-screen font-sans selection:bg-cyan-500/30 selection:text-cyan-200 antialiased flex flex-col justify-between">
		<!-- Liquid Glass Background Blobs -->
		<div class="fixed inset-0 -z-50 overflow-hidden pointer-events-none">
			<div class="absolute -top-[20%] -left-[10%] w-[55%] h-[55%] rounded-full bg-teal-500/12 blur-[130px] animate-blob"></div>
			<div class="absolute top-[30%] -right-[15%] w-[65%] h-[65%] rounded-full bg-blue-600/10 blur-[160px] animate-blob animation-delay-2000"></div>
			<div class="absolute -bottom-[20%] left-[15%] w-[50%] h-[50%] rounded-full bg-purple-600/8 blur-[130px] animate-blob animation-delay-4000"></div>
		</div>

		<!-- Navigation Header -->
		<header class="sticky top-0 z-40 w-full border-b border-white/5 bg-[#090c12]/70 backdrop-blur-md">
			<div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
				<!-- Logo -->
				<a href={homePath} class="flex items-center gap-2.5 group">
					<img
						src="/app-icon.png"
						alt="Den Browser Icon"
						class="h-8 w-8 rounded-[7px] shadow-md shadow-cyan-500/10 group-hover:scale-105 transition-transform"
						width="32"
						height="32"
					/>
					<span class="font-semibold text-lg tracking-tight text-white">Den Browser</span>
				</a>

				<!-- Desktop Nav Links -->
				<nav class="hidden md:flex items-center gap-8">
					<a href={`${homePath}#features`} class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">{t('nav.features')}</a>
					<a href={`${homePath}#install`} class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">{t('nav.download')}</a>
					<a href="https://github.com/nekonata-team/den-browser" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors flex items-center gap-1.5">
						{t('nav.github')}
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
					</a>
				</nav>

				<!-- Nav CTA & Language Switcher -->
				<div class="flex items-center gap-4">
					{lang === 'en' ? (
						<a href={alternatePath} class="text-xs font-semibold text-zinc-400 hover:text-white transition-colors bg-white/5 border border-white/5 hover:border-white/10 px-2.5 py-1 rounded">JA</a>
					) : (
						<a href={alternatePath} class="text-xs font-semibold text-zinc-400 hover:text-white transition-colors bg-white/5 border border-white/5 hover:border-white/10 px-2.5 py-1 rounded">EN</a>
					)}
					<a href={`${homePath}#install`} class="hidden sm:inline-flex glass-button text-xs py-2 px-4">
						{t('nav.download')}
					</a>
				</div>
			</div>
		</header>

		<!-- Main Content Slot -->
		<main class="flex-grow">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="w-full border-t border-white/5 bg-[#06080d] py-12 text-sm text-zinc-500">
			<div class="mx-auto max-w-7xl px-6 flex flex-col md:flex-row items-center justify-between gap-6">
				<div class="flex items-center gap-2.5">
					<img src="/app-icon.png" alt="Den Browser" class="h-5 w-5 rounded-[4px] opacity-80" width="20" height="20" />
					<span class="font-medium text-zinc-400">Den Browser</span>
					<span>&copy; {new Date().getFullYear()} nekonata. {t('footer.rights')}</span>
				</div>
				<div class="flex items-center gap-6">
					<a href={lang === 'en' ? "/privacy" : "/ja/privacy"} class="hover:text-zinc-300 transition-colors">{t('legal.privacy')}</a>
					<a href={lang === 'en' ? "/terms" : "/ja/terms"} class="hover:text-zinc-300 transition-colors">{t('legal.terms')}</a>
					<a href="https://github.com/nekonata-team/den-browser" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-300 transition-colors">{t('nav.github')}</a>
				</div>
			</div>
		</footer>
	</body>
</html>
