{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)project\\.pbxproj$"
      ],
      "matchStrings": [
        "repositoryURL = \"https://github\\.com/(?<depName>[^/]+/[^/\"]+?)(?:\\.git)?\";\\s*requirement = \\{\\s*kind = [^;]+;\\s*minimumVersion = (?<currentValue>[^;]+);"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["web/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "web dependencies"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development tools"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "swift packages"
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": null
    }
  ]
}
